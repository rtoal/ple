TO pad :n
OUTPUT IFELSE :n < 10 [WORD "0 :n] [:n]
end

FOR [i 0 10] [
    MAKE "t 43200 * :i + 21600
    MAKE "t :t - MODULO :t 11
    MAKE "t :t / 11
    MAKE "h :t - MODULO :t 3600
    MAKE "h :h / 3600
    MAKE "h IFELSE :h = 0 12 :h
    MAKE "m :t - MODULO :t 60
    MAKE "m MODULO :m / 60 60
    MAKE "s MODULO :t 60
    PRINT WORD pad :h WORD ": WORD pad :m WORD ": pad :s
]